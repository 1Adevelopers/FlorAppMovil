<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/white">

    <!-- 1. Título Principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INICIAR SESIÓN"
        android:textColor="@color/verde1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- 2. Campo de entrada para el Usuario -->
    <EditText
        android:id="@+id/etUsuario"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nombre de usuario"
        android:inputType="textPersonName"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/input_fondo"
        android:textColor="@color/texto_principal"
        android:layout_marginBottom="16dp" />

    <!-- 3. Campo de entrada para la Contraseña -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/input_fondo"
        android:textColor="@color/texto_principal"
        android:layout_marginBottom="24dp" />

    <!-- 4. Botón de Acción -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="INGRESAR"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/boton_redondeado"
        app:backgroundTint="@null"/>

    <TextView
        android:id="@+id/tvInvitado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresar como Invitado"
        android:textColor="@color/gris"
        android:textSize="14sp"
        android:padding="16dp"
        android:layout_marginTop="5dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/tvIrARegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿No tenés cuenta? Registrate"
        android:textColor="@color/verde1"
        android:textSize="14sp"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>