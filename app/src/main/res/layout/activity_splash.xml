<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    tools:context=".SplashActivity">

    <!-- Halo naranja decorativo detrás del logo -->
    <View
        android:id="@+id/viewHalo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_logo_halo"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/florapp_logo"
        app:layout_constraintBottom_toBottomOf="@id/florapp_logo"
        app:layout_constraintStart_toStartOf="@id/florapp_logo"
        app:layout_constraintEnd_toEndOf="@id/florapp_logo" />

    <!-- Logo centrado -->
    <ImageView
        android:id="@+id/florapp_logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/florapp_logo"
        android:alpha="0"
        android:scaleX="0.6"
        android:scaleY="0.6"
        app:layout_constraintBottom_toTopOf="@id/txtAppName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Nombre de la app: "Flor" y "App" en color verde -->
    <LinearLayout
        android:id="@+id/txtAppName"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/florapp_logo"
        app:layout_constraintBottom_toTopOf="@id/txtTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flor"
            android:fontFamily="@font/fredoka_bold"
            android:textColor="@color/verde_pastel"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App"
            android:fontFamily="@font/fredoka_bold"
            android:textColor="@color/verde_pastel"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nuevo subtítulo con la fuente Fredoka Bold en blanco y centrado en dos líneas -->
    <TextView
        android:id="@+id/txtTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:text="Descubrí la Flora Nativa\nde Córdoba"
        android:fontFamily="@font/fredoka_bold"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:gravity="center"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/txtAppName"
        app:layout_constraintBottom_toTopOf="@id/progressSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <!-- Indicador de carga -->
    <ProgressBar
        android:id="@+id/progressSplash"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:indeterminateTint="@color/naranja"
        app:layout_constraintTop_toBottomOf="@id/txtTagline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp" />

</androidx.constraintlayout.widget.ConstraintLayout>