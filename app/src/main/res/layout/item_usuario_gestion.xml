<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/modal_background"
    android:padding="16dp"
    android:layout_marginBottom="16dp"
    android:elevation="2dp">

    <!-- Rol del Usuario (Ej: Admin / Docente) -->
    <TextView
        android:id="@+id/tvRolUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextoPrincipal"
        android:text="Admin"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- Nombre completo -->
    <TextView
        android:id="@+id/tvNombreUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextoPrincipal"
        android:text="Nombre y Apellido" />

    <!-- Email -->
    <TextView
        android:id="@+id/tvEmailUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextoInput"
        android:text="correo@email.com"
        android:layout_marginBottom="12dp" />

    <!-- Botones de acción de la tarjeta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnActualizarUsuario"
            style="@style/BotonEstilo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Actualizar"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnBorrarUsuario"
            style="@style/BotonEstilo"
            android:backgroundTint="#F28B82"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Borrar"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>