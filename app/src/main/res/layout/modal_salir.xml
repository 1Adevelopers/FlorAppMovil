<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/modal_background"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/tvModalSalirTitulo"
        style="@style/TituloModal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="¿Deseás salir?"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnModalSalirCancelar"
            style="@style/BotonEstilo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:backgroundTint="@color/rojo_pastel"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnModalSalirAceptar"
            style="@style/BotonEstilo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Aceptar"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>