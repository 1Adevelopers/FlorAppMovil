<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Titulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel de Control"
            style="@style/TituloPrincipal"
            android:layout_marginBottom="20dp" />

        <!-- Botones de gestión superior (Usuarios seleccionado, Fichas deseleccionado) -->
        <LinearLayout
            android:id="@+id/contenedorBotonesGestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Botón Usuarios (Seleccionado / Verde fuerte) -->
            <Button
                android:id="@+id/btnUsuarios"
                style="@style/BotonEstilo"
                android:backgroundTint="@color/verde1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Usuarios"
                app:icon="@drawable/icono_usuario"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white"/>

            <!-- Botón Fichas (Deseleccionado) -->
            <Button
                android:id="@+id/btnFichas"
                style="@style/BotonEstilo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Fichas"
                app:icon="@drawable/icono_ficha"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white"/>

        </LinearLayout>

        <!-- Subtitulo -->
        <TextView
            style="@style/TextoPrincipal"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="Usuarios" />

        <!-- Descripción -->
        <TextView
            style="@style/TextoPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="16dp"
            android:textSize="12sp"
            android:textColor="@color/gris"
            android:text="Gestiona los miembros y permisos del ecosistema FlorApp" />

        <Button
            android:id="@+id/btnAnadirUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BotonEstilo"
            android:text="Añadir Usuario"
            android:layout_marginBottom="12dp"/>

        <!-- Contenedor dinámico de Usuarios -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/contenedorUsuarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>
    </LinearLayout>
    <include
        layout="@layout/navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>