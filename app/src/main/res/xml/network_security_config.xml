<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Por defecto, SE EXIGE HTTPS para todo. Tráfico HTTP será bloqueado -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- EXCEPCIÓN: Solo permitimos HTTP para la IP de tu PC de desarrollo -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- REEMPLAZA ESTA IP POR LA DE TU PC (la misma del RetrofitClient) -->
        <domain includeSubdomains="true">192.168.1.231</domain>
        <domain includeSubdomains="true">192.168.120.54</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>